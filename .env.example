# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
#
# For the deployed Cloudflare Worker these are set as Worker secrets
# instead (`wrangler secret put <NAME>`), not from this file.

# ── Supabase ────────────────────────────────────────────────
# Shared platform project — the same project backs partners.508.world.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/publishable key>

# Server-only. Bypasses RLS entirely: used for creating auth accounts,
# tenant provisioning, and resolving a subdomain to a showroom before the
# visitor has a session. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# ── Licensing / provisioning ────────────────────────────────
# Bearer token that POST /api/provision requires. The 508.world Worker
# presents it after an admin approves a FELIX licence request, which is
# the only way a showroom tenant comes into existence.
#
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The same value must be set on the Worker side:
#   cd ../508.world/worker && wrangler secret put FELIX_PROVISION_SECRET
PROVISION_SECRET=<random 32-byte token>

# ── Cloudflare R2 (vehicle photos, bank contract PDFs) ──────
# Server-only — uploads go through presigned URLs minted by /api/upload,
# so the browser never holds these.
R2_ACCOUNT_ID=<account id>
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
R2_BUCKET_NAME=<bucket name>
R2_PUBLIC_URL=https://<public bucket host>

# ── ETA e-invoicing (Egyptian Tax Authority) ────────────────
# Decision 281/2025 makes e-invoicing mandatory. FELIX builds, signs and
# submits the document itself (src/lib/eta, migration 0034); migration
# 0024's manual transcription remains as the fallback.
#
# EVERY ONE OF THESE IS OPTIONAL, and the defaults land on the sandbox:
# with nothing set, ETA_MODE is `mock`, nothing is filed with anybody,
# and the panel shows a Sandbox badge on every submission. Going live is
# deliberate, and each step of it fails loudly rather than quietly.

# mock | preprod | production.   Default: mock.
#   mock        submissions are simulated in-process and file NOTHING.
#               The mock validates the document the way the authority
#               does, so a rejection is a real rejection.
#   preprod     ETA's sandbox. Real transport, test credentials.
#   production  the authority. Requires a real e-seal signature.
ETA_MODE=mock

# The documented endpoints. No defaults in code, on purpose — a default
# URL is how a misconfigured deployment reaches somebody's real service.
#   preprod:     ETA_ID_BASE=https://id.preprod.eta.gov.eg
#                ETA_API_BASE=https://api.preprod.invoicing.eta.gov.eg
#   production:  ETA_ID_BASE=https://id.eta.gov.eg
#                ETA_API_BASE=https://api.invoicing.eta.gov.eg
# ETA_ID_BASE=<ETA identity server base URL>
# ETA_API_BASE=<ETA invoicing API base URL>

# OAuth2 client_credentials, issued by ETA on the taxpayer's portal
# account. Required for preprod and production; unused in mock.
# ETA_CLIENT_ID=<client id>
# ETA_CLIENT_SECRET=<client secret>

# none | hmac-dev | cades-bes.  Default: none in mock, cades-bes otherwise.
#   none        no signature. Permitted ONLY when ETA_MODE=mock.
#   hmac-dev    deterministic development signature over ETA's canonical
#               serialization, prefixed DEV-HMAC-SHA256 so it can never
#               be mistaken for an e-seal. Refused when ETA_MODE=production.
#   cades-bes   the real CAdES-BES e-seal. NOT IMPLEMENTED — it needs the
#               organisation's X.509 token over PKCS#11, which a Worker
#               cannot hold. See the header of src/lib/eta/signing.ts for
#               exactly what plugs in at go-live.
# ETA_SIGNING_MODE=hmac-dev
# ETA_SIGNING_KEY=<any string; only used by hmac-dev>
# ETA_SIGNER_URL=<future: the e-seal signing service that holds the token>

# The seller, as the invoice must name them. The VAT registration comes
# from branches.tax_registration_no (migration 0022) and is NOT here.
#   ETA_BRANCH_CODE   the branch code ETA assigned on the portal.
#                     Defaults to "0" (a single-branch taxpayer's head
#                     office) with a warning. A multi-branch group must
#                     set it before production.
#   ETA_ACTIVITY_CODE the taxpayer's ISIC activity code. Defaults to
#                     4510 (sale of motor vehicles).
# ETA_BRANCH_CODE=0
# ETA_ACTIVITY_CODE=4510

# The seller's structured address. ETA wants these as separate fields and
# branches.address is one free-text line, so they are configuration.
# ETA_ISSUER_STREET falls back to branches.address when unset. Outside
# mock, leaving these empty BLOCKS submission rather than guessing.
# ETA_ISSUER_COUNTRY=EG
# ETA_ISSUER_GOVERNATE=<e.g. Cairo>
# ETA_ISSUER_REGION_CITY=<e.g. Maadi>
# ETA_ISSUER_STREET=<street>
# ETA_ISSUER_BUILDING_NUMBER=<building number>
# ETA_ISSUER_POSTAL_CODE=<postal code>

# How long one request waits for the authority to settle a submission
# before leaving the row as `submitted`. Milliseconds, capped at 20000.
# ETA_POLL_BUDGET_MS=6000
