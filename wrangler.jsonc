{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "filex",
	"compatibility_date": "2026-07-29",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Where meeting notifications and uncaught-error reports are sent —
	// the 508.world router Worker owns the whole email pipeline. A plain
	// var, not a secret: it is a public hostname, and keeping it here
	// means a deploy can never lose it. Its companion NOTIFY_SECRET is a
	// real secret (`wrangler secret put NOTIFY_SECRET`) and must match
	// the value set on the router Worker.
	//
	// "Must match" is not decoration: these drifted apart once and every
	// error report was silently rejected with 403 for as long as they did.
	// Nothing surfaces that — instrumentation.ts is fail-silent by design,
	// so a mismatch looks exactly like an application that never errors.
	// When rotating, set BOTH Workers in the same operation:
	//
	//   printf '%s' "$SECRET" | wrangler secret put NOTIFY_SECRET --name 508world-subdomain-router
	//   printf '%s' "$SECRET" | wrangler secret put NOTIFY_SECRET --name filex
	//
	// then REDEPLOY this Worker. Observed: after the secret was rotated,
	// this side kept presenting the old value until a redeploy — plain
	// propagation delay may explain it, but the redeploy is deterministic
	// and costs a minute, so do not skip it and then trust a 403.
	//
	// To verify end to end, throw from a temporary route and watch the
	// router's tail for `reportError: sent`. A 202 is the success signal.
	"vars": {
		"NOTIFY_URL": "https://partners.508.world"
	},
	// Workers Logs: persisted invocation logs, unsampled. The email error
	// reports (src/instrumentation.ts) carry the headline; these logs are
	// where the surrounding requests get read when an email arrives.
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		}
	}
}
